        <h1 class="font-extrabold text-3xl tracking-wider">WORDLE</h1>
        <button id="reset-btn" class="w-8 h-8 flex items-center justify-center text-gray-400 hover:text-white transition-colors" title="New Game">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
        </button>
    </header>

    <!-- GAME BOARD -->
    <main class="flex-grow flex items-center justify-center w-full overflow-hidden">
        <div id="board" class="grid grid-rows-6 gap-[5px] p-[10px] w-full max-w-[350px] aspect-[5/6]">
            <!-- Rows injected by JS -->
        </div>
    </main>

    <!-- KEYBOARD -->
    <div id="keyboard" class="w-full max-w-[500px] px-2 pb-8 pt-2 flex flex-col gap-2">
        <div class="flex gap-1.5 justify-center w-full">
            <button class="key key-normal" data-key="q">Q</button>
            <button class="key key-normal" data-key="w">W</button>
            <button class="key key-normal" data-key="e">E</button>
            <button class="key key-normal" data-key="r">R</button>
            <button class="key key-normal" data-key="t">T</button>
            <button class="key key-normal" data-key="y">Y</button>
            <button class="key key-normal" data-key="u">U</button>
            <button class="key key-normal" data-key="i">I</button>
            <button class="key key-normal" data-key="o">O</button>
            <button class="key key-normal" data-key="p">P</button>
        </div>
        <div class="flex gap-1.5 justify-center w-full px-[5%]">
            <button class="key key-normal" data-key="a">A</button>
            <button class="key key-normal" data-key="s">S</button>
            <button class="key key-normal" data-key="d">D</button>
            <button class="key key-normal" data-key="f">F</button>
            <button class="key key-normal" data-key="g">G</button>
            <button class="key key-normal" data-key="h">H</button>
            <button class="key key-normal" data-key="j">J</button>
            <button class="key key-normal" data-key="k">K</button>
            <button class="key key-normal" data-key="l">L</button>
        </div>
        <div class="flex gap-1.5 justify-center w-full">
            <button class="key key-wide" data-key="enter">ENTER</button>
            <button class="key key-normal" data-key="z">Z</button>
            <button class="key key-normal" data-key="x">X</button>
            <button class="key key-normal" data-key="c">C</button>
            <button class="key key-normal" data-key="v">V</button>
            <button class="key key-normal" data-key="b">B</button>
            <button class="key key-normal" data-key="n">N</button>
            <button class="key key-normal" data-key="m">M</button>
            <button class="key key-wide" data-key="backspace">
                <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24">
                    <path fill="var(--color-tone-1)" d="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H7.07L2.4 12l4.66-7H22v14zm-11.59-2L14 13.41 17.59 17 19 15.59 15.41 12 19 8.41 17.59 7 14 10.59 10.41 7 9 8.41 12.59 12 9 15.59z"></path>
                </svg>
            </button>
        </div>
    </div>

