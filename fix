YACHT0YARDS0YARN0YARNS0YAWNS0YEARS0YEAST0YELLS0YELP0YELPS0YIELD0
YOGA0YOGI0YOKEL0YOKES0YOLKS0YOUNG0YOURS0YOUTH0ZEBRA0ZEST0ZESTY0
ZILCH0ZINCS0ZIPPY0ZOMBIE0ZONES0ZOOMS
`;

        // Parse and generate dictionary dynamically from the dataset using regex
        function buildFullDictionary() {
            const matches = EMBEDDED_WORDS_RAW.match(/[A-Za-z]{5}/g);
            if (matches) {
                matches.forEach(w => VALID_WORDS.add(w.toUpperCase()));
            }
        }
        buildFullDictionary();

        // Also fetch official full extended Wordle dataset if available
        async function loadExtendedDictionary() {
            const endpoints = [
                'https://raw.githubusercontent.com/tabatkins/wordle-list/main/words',
                'https://gist.githubusercontent.com/cfreshman/cdcdf77747a1643194a0d9e87515a812/raw/wordle-answers-alphabetical.txt'
            ];
            for (const url of endpoints) {
                try {
                    const res = await fetch(url);
                    if (res.ok) {
                        const text = await res.text();
                        const words = text.split(/\r?\n/);
                        words.forEach(w => {
                            const trimmed = w.trim().toUpperCase();
                            if (trimmed.length === 5) VALID_WORDS.add(trimmed);
                        });
                    }
                } catch (e) {
                    // Fall back cleanly to the built-in dataset
                }
            }
        }
        loadExtendedDictionary();

        const WORD_LENGTH = 5;
        const MAX_GUESSES = 6;
        
        let gameState = 'setup'; // 'setup', 'playing', 'won', 'lost'
        let secretWord = '';
        let guesses = Array(MAX_GUESSES).fill('');
        let currentRowIndex = 0;
        let currentGuess = '';

        // DOM Elements
        const setupView = document.getElementById('setup-view');
        const setupInput = document.getElementById('setup-input');
        const setupError = document.getElementById('setup-error');
        const startBtn = document.getElementById('start-btn');
        const board = document.getElementById('board');
        const keyboard = document.getElementById('keyboard');
        const resetBtn = document.getElementById('reset-btn');
        const toastContainer = document.getElementById('toast-container');

        // --- Setup Phase Logic ---
        
        setupInput.addEventListener('input', (e) => {
            // Force uppercase and remove non-letters
            let val = e.target.value.toUpperCase().replace(/[^A-Z]/g, '');
            e.target.value = val;
            
            if (val.length === WORD_LENGTH) {
                // Ensure secret word is registered in dictionary for Player 2
                VALID_WORDS.add(val);
                setupError.style.opacity = '0';
                startBtn.disabled = false;
                startBtn.classList.remove('opacity-50', 'bg-[#818384]', 'cursor-not-allowed');
                startBtn.classList.add('bg-[#538d4e]', 'hover:bg-[#43723f]', 'cursor-pointer');
            } else {
                setupError.style.opacity = '0';
                startBtn.disabled = true;
                resetStartButton();
            }
        });

        setupInput.addEventListener('keydown', (e) => {
             if (e.key === 'Enter' && !startBtn.disabled) {
                 startGame();
             }
        });

        function resetStartButton() {
            startBtn.classList.add('opacity-50', 'bg-[#818384]', 'cursor-not-allowed');
            startBtn.classList.remove('bg-[#538d4e]', 'hover:bg-[#43723f]', 'cursor-pointer');
        }

        startBtn.addEventListener('click', startGame);

        function startGame() {
            secretWord = setupInput.value.toUpperCase();
            setupView.classList.add('hidden');
            gameState = 'playing';
            initializeBoard();
            document.activeElement.blur(); // Remove focus from input to avoid accidental typing
            showToast("Player 2: Start Guessing!", 2500);
        }

        // --- Game Board Logic ---
        
        function initializeBoard() {
            board.innerHTML = '';
            for (let i = 0; i < MAX_GUESSES; i++) {
                const row = document.createElement('div');
                row.className = 'row grid grid-cols-5 gap-[5px] w-full h-full';
                row.id = `row-${i}`;
                
                for (let j = 0; j < WORD_LENGTH; j++) {
                    const tile = document.createElement('div');
                    tile.className = 'tile';
                    tile.id = `tile-${i}-${j}`;
                    tile.dataset.state = 'empty';
                    row.appendChild(tile);
                }
                board.appendChild(row);
            }
        }

        // --- Input Handling ---

        function handleInput(key) {
            if (gameState !== 'playing') return;

            if (key === 'ENTER') {
                submitGuess();
            } else if (key === 'BACKSPACE') {
                deleteLetter();
            } else if (/^[A-Z]$/.test(key)) {
                addLetter(key);
            }
        }

        function addLetter(letter) {
            if (currentGuess.length < WORD_LENGTH) {
                currentGuess += letter;
                updateGrid();
            }
        }

        function deleteLetter() {
            if (currentGuess.length > 0) {
                currentGuess = currentGuess.slice(0, -1);
                updateGrid();
            }
        }

        function updateGrid() {
            const row = document.getElementById(`row-${currentRowIndex}`);
            const tiles = row.querySelectorAll('.tile');
            
            for (let i = 0; i < WORD_LENGTH; i++) {
                const tile = tiles[i];
                if (i < currentGuess.length) {
                    tile.textContent = currentGuess[i];
                    tile.dataset.state = 'tbd';
                } else {
                    tile.textContent = '';
                    tile.dataset.state = 'empty';
                    // Remove animation class if letter is deleted
                    tile.style.animation = 'none'; 
                    tile.offsetHeight; /* trigger reflow */
                    tile.style.animation = null; 
                }
            }
        }

        function submitGuess() {
            if (currentGuess.length !== WORD_LENGTH) {
                showToast("Not enough letters");
                shakeRow();
                return;
            }

            if (!VALID_WORDS.has(currentGuess)) {
                showToast("Not in word list");
                shakeRow();
                return;
            }

            const row = document.getElementById(`row-${currentRowIndex}`);
            const tiles = row.querySelectorAll('.tile');
            const guessArray = currentGuess.split('');
            const targetArray = secretWord.split('');
            const statuses = Array(WORD_LENGTH).fill('absent');

            // Evaluate guess (Pass 1: Correct)
            for (let i = 0; i < WORD_LENGTH; i++) {
                if (guessArray[i] === targetArray[i]) {
                    statuses[i] = 'correct';
                    targetArray[i] = null;
                    guessArray[i] = null;
                }
            }

            // Evaluate guess (Pass 2: Present)
            for (let i = 0; i < WORD_LENGTH; i++) {
                if (guessArray[i] !== null && targetArray.includes(guessArray[i])) {
                    statuses[i] = 'present';
                    targetArray[targetArray.indexOf(guessArray[i])] = null;
                }
            }

            gameState = 'animating'; // Lock input during animation
            
            // Animate tiles
            tiles.forEach((tile, index) => {
                setTimeout(() => {
                    tile.dataset.animation = 'flip-in';
                    
                    tile.addEventListener('animationend', () => {
                        if(tile.dataset.animation === 'flip-in') {
                             // Middle of flip: update colors
                             tile.dataset.state = statuses[index];
                             tile.dataset.animation = 'flip-out';
                             updateKeyboard(currentGuess[index], statuses[index]);
                        } else if (tile.dataset.animation === 'flip-out') {
                             tile.removeAttribute('data-animation');
                             
                             // If it's the last tile finishing animation
                             if (index === WORD_LENGTH - 1) {
                                 finalizeGuess(currentGuess === secretWord);
                             }
                        }
                    }, {once: false}); // Note: event listener logic handles the dual states
                    
                }, index * 250); // Stagger animation
            });
        }

        function finalizeGuess(isWin) {
            guesses[currentRowIndex] = currentGuess;
            
            if (isWin) {
                gameState = 'won';
                setTimeout(() => showToast(getWinMessage(currentRowIndex), 5000), 500);
            } else if (currentRowIndex === MAX_GUESSES - 1) {
                gameState = 'lost';
                setTimeout(() => showToast(secretWord, 10000), 500);
            } else {
                currentRowIndex++;
                currentGuess = '';
                gameState = 'playing';
            }
        }

        function updateKeyboard(letter, status) {
            const keyBtn = document.querySelector(`.key[data-key="${letter.toLowerCase()}"]`);
            if (!keyBtn) return;

            const currentStatus = keyBtn.dataset.state;
            
            if (status === 'correct' || currentStatus === 'correct') {
                keyBtn.dataset.state = 'correct';
            } else if (status === 'present' && currentStatus !== 'correct') {
                keyBtn.dataset.state = 'present';
            } else if (status === 'absent' && !currentStatus) {
                keyBtn.dataset.state = 'absent';
            }
        }

        function shakeRow() {
            const row = document.getElementById(`row-${currentRowIndex}`);
            row.classList.remove('shake');
            void row.offsetWidth; // trigger reflow
            row.classList.add('shake');
            setTimeout(() => row.classList.remove('shake'), 500);
        }

        // --- Helpers ---

        function showToast(message, duration = 2000) {
            const toast = document.createElement('div');
            toast.textContent = message;
            toast.className = 'toast-message';
            toastContainer.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => {
                    if (toastContainer.contains(toast)) {
                        toastContainer.removeChild(toast);
                    }
                }, 300); // Matches CSS transition duration
            }, duration);
        }
        
        function getWinMessage(attempts) {
            const messages = ["Genius", "Magnificent", "Impressive", "Splendid", "Great", "Phew"];
            return messages[attempts] || "You got it!";
        }

        // Reset Game
        resetBtn.addEventListener('click', () => {
            // Reset State
            gameState = 'setup';
            secretWord = '';
            guesses = Array(MAX_GUESSES).fill('');
            currentRowIndex = 0;
            currentGuess = '';
            
            // Reset UI
            setupInput.value = '';
            setupError.style.opacity = '0';
            startBtn.disabled = true;
            resetStartButton();
            setupView.classList.remove('hidden');
            
            board.innerHTML = '';
            
            const keys = document.querySelectorAll('.key');
            keys.forEach(key => key.removeAttribute('data-state'));
            
            toastContainer.innerHTML = '';
        });

        // Event Listeners
        document.addEventListener('keydown', (e) => {
            if (gameState === 'setup' || gameState === 'animating') return;
            
            if (e.key === 'Enter') handleInput('ENTER');
            else if (e.key === 'Backspace') handleInput('BACKSPACE');
            else if (e.key.match(/^[a-zA-Z]$/)) handleInput(e.key.toUpperCase());
        });

        keyboard.addEventListener('click', (e) => {
            if (gameState === 'setup' || gameState === 'animating') return;
            
            const keyBtn = e.target.closest('.key');
            if (keyBtn) {
                const key = keyBtn.dataset.key.toUpperCase();
                handleInput(key);
                
                // Remove focus to prevent Enter key triggering the last clicked button
                keyBtn.blur();
            }
        });

    </script>
</body>
